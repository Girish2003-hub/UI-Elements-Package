{
  "name": "@girishkhedikar/buttonpackage",
  "version": "0.0.1",
  "description": "Reusable React button component package",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "react",
    "button",
    "component",
    "typescript",
    "ui"
  ],
  "author": "Girish Khedikar",
  "license": "ISC",
  "type": "module",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
